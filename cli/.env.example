# pdf-autofillr-cli — environment configuration
# Copy to .env and fill in your values.
#
#   cp .env.example .env

# ── LLM API Key (required) ────────────────────────────────────────────────────
# Pick one — whichever LLM provider you use.

OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# ── Optional: default PDF paths ───────────────────────────────────────────────
# Set these to avoid typing --pdf and --output on every command.

# INPUT_PDF=data/input/blank_form.pdf
# OUTPUT_DIR=data/output/

# ── Noise suppression (recommended) ──────────────────────────────────────────
LITELLM_LOG=ERROR
LITELLM_LOCAL_MODEL_COST_MAP=True
MAPPER_LOG_LEVEL=ERROR
RAGPDF_LOG_LEVEL=WARNING
