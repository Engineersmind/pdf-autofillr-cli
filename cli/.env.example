# ============================================================
# pdf-autofillr-cli — environment reference
# Copy to .env and fill in values for the modules you use.
# Only configure sections relevant to your setup.
# ============================================================


# ════════════════════════════════════════════════════════════
# RAG MODULE  (pdf-autofillr rag ...)
# Install: pip install "pdf-autofillr-cli[rag]"
# ════════════════════════════════════════════════════════════

# Storage backend for predictions, metrics, and feedback
# Options: local | s3 | azure | gcs
RAGPDF_STORAGE=local
RAGPDF_DATA_PATH=./data/rag

# S3 (when RAGPDF_STORAGE=s3)
# RAGPDF_S3_BUCKET=your-bucket
# RAGPDF_S3_REGION=us-east-1
# RAGPDF_S3_PREFIX=ragpdf/

# Azure Blob (when RAGPDF_STORAGE=azure)
# RAGPDF_AZURE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...
# RAGPDF_AZURE_ACCOUNT=mystorageaccount
# RAGPDF_AZURE_CONTAINER=ragpdf

# GCS (when RAGPDF_STORAGE=gcs)
# RAGPDF_GCS_BUCKET=your-bucket
# RAGPDF_GCS_PREFIX=ragpdf/

# Embedding backend — what generates vectors
# Options: sentence_transformer | openai | litellm | noop (tests only)
RAGPDF_EMBEDDING_BACKEND=sentence_transformer
RAGPDF_ST_MODEL=all-MiniLM-L6-v2

# OpenAI embeddings (when RAGPDF_EMBEDDING_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# RAGPDF_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LiteLLM embeddings (when RAGPDF_EMBEDDING_BACKEND=litellm)
# RAGPDF_LITELLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# Vector store backend
# Options: local | s3 | azure | gcs | pinecone | chroma | weaviate
RAGPDF_VECTOR_STORE=local

# Pinecone (when RAGPDF_VECTOR_STORE=pinecone)
# PINECONE_API_KEY=your-pinecone-key
# RAGPDF_PINECONE_INDEX=ragpdf-vectors
# RAGPDF_PINECONE_NAMESPACE=default

# ChromaDB (when RAGPDF_VECTOR_STORE=chroma)
# RAGPDF_CHROMA_PATH=./chroma_data
# RAGPDF_CHROMA_COLLECTION=ragpdf_vectors

# Weaviate (when RAGPDF_VECTOR_STORE=weaviate)
# RAGPDF_WEAVIATE_URL=http://localhost:8080
# RAGPDF_WEAVIATE_API_KEY=
# RAGPDF_WEAVIATE_CLASS=RagpdfVector

# LLM corrector — improves field names on user feedback
# Options: noop | openai | anthropic | litellm
RAGPDF_CORRECTOR_BACKEND=noop

# OpenAI corrector (when RAGPDF_CORRECTOR_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# RAGPDF_OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic corrector (when RAGPDF_CORRECTOR_BACKEND=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# RAGPDF_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Prediction tuning
RAGPDF_PREDICTION_THRESHOLD=0.75
RAGPDF_TOP_K=5
RAGPDF_CONFIDENCE_DECAY_RATE=0.95
RAGPDF_CONFIDENCE_GROWTH_RATE=1.05
RAGPDF_MAX_CONFIDENCE=0.99
RAGPDF_MIN_CONFIDENCE=0.50

# RAG server auth and port (used by: pdf-autofillr rag start)
RAGPDF_API_KEY=dev-key
RAGPDF_SERVER_HOST=0.0.0.0
RAGPDF_SERVER_PORT=8000
RAGPDF_LOG_LEVEL=INFO
RAGPDF_DEBUG=false


# ════════════════════════════════════════════════════════════
# CHATBOT MODULE  (pdf-autofillr chatbot ...)
# Install: pip install "pdf-autofillr-cli[chatbot]"
# ════════════════════════════════════════════════════════════

# LLM powering the conversation
# CHATBOT_LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Storage for session data
# chatbot_STORAGE=local
# chatbot_DATA_PATH=./data/chatbot
# chatbot_CONFIG_PATH=./configs

# PDF filling integration
# chatbot_PDF_FILLER=none      # none | mapper | managed
# chatbot_PDF_PATH=./data/input/blank_form.pdf

# Server port (used by: pdf-autofillr chatbot start)
# CHATBOT_SERVER_PORT=8001


# ════════════════════════════════════════════════════════════
# MAPPER MODULE  (pdf-autofillr mapper ...)
# Install: pip install "pdf-autofillr-cli[mapper]"
# ════════════════════════════════════════════════════════════

# LLM for semantic field mapping
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Cloud storage for mapper cache
# CLOUD_PROVIDER=local          # local | aws | azure | gcp

# RAG integration (optional)
# RAG_ENABLED=false
# RAG_MODE=inprocess             # inprocess | http
# RAG_API_URL=http://localhost:8000

# Server port (used by: pdf-autofillr mapper start)
# MAPPER_SERVER_PORT=8002


# ════════════════════════════════════════════════════════════
# DOC UPLOAD MODULE  (pdf-autofillr doc-upload ...)
# Install: pip install "pdf-autofillr-cli[doc-upload]"
# ════════════════════════════════════════════════════════════

# LLM for data extraction from documents
# DOC_UPLOAD_LLM_MODEL=openai/gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Storage for extracted data
# DOC_UPLOAD_STORAGE=local
# DOC_UPLOAD_DATA_PATH=./data/doc_upload

# PDF filling integration
# DOC_UPLOAD_PDF_FILLER=none    # none | mapper | managed
# DOC_UPLOAD_PDF_PATH=./data/input/blank_form.pdf

# Server port (used by: pdf-autofillr doc-upload start)
# DOC_UPLOAD_SERVER_PORT=8003
